# Use memory for the zero-setup path, or dynamodb for Checkpoint 8 durability.
MANIFEST_MODE=shadow
MANIFEST_STORAGE_BACKEND=memory
MANIFEST_DYNAMODB_ENDPOINT=http://127.0.0.1:18000
MANIFEST_DYNAMODB_TABLE=manifest-local
MANIFEST_DEMO_NAMESPACE=local-demo
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DEMO_APPROVER_SECRET=replace-with-a-local-demo-value
ENABLE_DEMO_TAMPER=false
DEMO_TAMPER_SECRET=replace-with-a-separate-local-demo-value
MANIFEST_POLICY_ENGINE=python_reference
CEDAR_ENDPOINT=http://127.0.0.1:8765
CEDAR_TIMEOUT_MS=100
CEDAR_POLICY_METADATA_PATH=policies/demo-v1/metadata.json
# Set this to the sidecar health bundle_hash to pin an exact Cedar bundle.
CEDAR_EXPECTED_BUNDLE_SHA256=
